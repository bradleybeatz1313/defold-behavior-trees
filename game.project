[project]
title = AI Behavior Trees
version = 1.0.0
dependencies#0 = https://github.com/britzl/defold-orthographic/archive/master.zip

[display]
width = 1280
height = 720

[physics]
type = 2D
gravity_y = 0

[script]
shared_state = 1

[bootstrap]
main_collection = /main/main.collectionc

[library]
include_dirs = ai,entities,utils
